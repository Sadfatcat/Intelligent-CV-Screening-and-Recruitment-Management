# [BẮT BUỘC] PostgreSQL connection string từ Neon
# Ví dụ: postgresql://user:password@ep-xxx.neon.tech/cvscreening?sslmode=require
DATABASE_URL=

# [TÙY CHỌN] Tài khoản admin mặc định khi khởi động lần đầu
DEFAULT_ADMIN_EMAIL=admin@cvscreening.local
DEFAULT_ADMIN_PASSWORD=Admin@123

# [TỰ ĐỘNG] Railway tự inject PORT - không cần điền
# PORT=8000
