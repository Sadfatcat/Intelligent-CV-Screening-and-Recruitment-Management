# Railway PostgreSQL URL. Railway usually injects DATABASE_URL automatically
# after you attach a Postgres database service.
DATABASE_URL=postgresql://postgres:password@host:5432/railway

# Admin account created on backend startup if it does not exist.
DEFAULT_ADMIN_EMAIL=admin@cvscreening.local
DEFAULT_ADMIN_PASSWORD=Admin@123

# Comma-separated frontend origins allowed to call the API directly.
# Example:
# CORS_ALLOW_ORIGINS=https://my-graduation-thesis.vercel.app,https://my-graduation-thesis-kbkttbvth-sadfatcats-projects.vercel.app
CORS_ALLOW_ORIGINS=*

# Public Railway backend URL, used when backend returns upload file URLs.
# Example: https://your-backend-service.up.railway.app
PUBLIC_UPLOAD_BASE_URL=http://127.0.0.1:8000
